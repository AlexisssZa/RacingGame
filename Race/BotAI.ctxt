comment3.text=\r\n\ \u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0442\ \u0432\u0441\u0435\ \u0447\u0435\u043A\u043F\u043E\u0438\u043D\u0442\u044B\ \u0438\u0437\ \u043C\u0438\u0440\u0430.\r\n\ \u0412\u0430\u0436\u043D\u043E\:\ Checkpoint\ \u0434\u043E\u043B\u0436\u043D\u044B\ \u0431\u044B\u0442\u044C\ \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B\ \u0432\ \u043C\u0438\u0440\ \u043A\ \u044D\u0442\u043E\u043C\u0443\ \u043C\u043E\u043C\u0435\u043D\u0442\u0443.\r\n\ \u0421\u043F\u0438\u0441\u043E\u043A\ \u0443\u0436\u0435\ \u043E\u0442\u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\ \u043F\u043E\ \u043F\u043E\u0440\u044F\u0434\u043A\u0443\ \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F\ (\u043F\u043E\u043B\u0435\ order\ \u0432\ Checkpoint).\r\n
